{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "case_id", "author_subject", "body", "created_at", "case_revision"],
  "properties": {
    "message_id": { "type": "string" },
    "case_id": { "type": "string" },
    "author_subject": { "type": "string" },
    "body": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "case_revision": { "type": "string", "pattern": "^[1-9][0-9]*$" }
  }
}
