{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["organization_id", "case_id", "state", "expected_revision", "idempotency_key"],
  "properties": {
    "organization_id": { "type": "string" },
    "case_id": { "type": "string" },
    "state": { "type": "string", "enum": ["open", "in_progress", "waiting_customer", "resolved", "closed"] },
    "reason": { "type": "string" },
    "expected_revision": { "type": "string" },
    "idempotency_key": { "type": "string" }
  },
  "additionalProperties": false
}

